<div class="qe-shell">
  <aside class="qe-sidebar">
    <div class="qe-brand"><i class="fa-solid fa-compass"></i><div><span>QUEDAÇO</span><strong>Explorador</strong></div><small>0.3.2</small></div>
    <label>Mapa da campanha<select name="scene" aria-label="Mapa da campanha">{{#each scenes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
    <nav aria-label="Menu do Explorador">{{#each nav}}<button type="button" data-tab="{{id}}" aria-current="{{#if active}}page{{else}}false{{/if}}"><i class="fa-solid fa-{{icon}}"></i>{{label}}</button>{{/each}}</nav>
    <div class="qe-progress"><small>DESCOBERTA DO MAPA</small><strong>{{stats.explored}} <span>/ {{stats.total}} áreas</span></strong><div class="qe-state-counts"><span>{{stats.hidden}} ocultas</span><span>{{stats.partial}} parciais</span></div><small>{{inactiveCount}} desativadas · {{unassignedCount}} sem região</small></div>
    <div class="qe-location"><small>GRUPO AGORA</small><strong>{{#if currentLocationName}}{{currentLocationName}}{{else}}Localização não definida{{/if}}</strong><small>{{dateText}}</small></div>
    <div class="qe-sidebar-bottom"><span class="qe-status {{#if enabled}}active{{/if}}">{{#if enabled}}Exploração ativa{{else}}Exploração desativada{{/if}}</span><small>{{#if isGM}}Modo Mestra · edição habilitada{{else}}Modo jogador · consulta{{/if}}</small></div>
  </aside>
  <main class="qe-main">
    <div class="qe-topbar"><div><small>QUEDAÇO - EXPLORADOR</small><h2>{{#if sceneName}}{{sceneName}}{{else}}Seu próximo mapa começa aqui{{/if}}</h2></div>{{#if hasScene}}{{#unless error}}<button type="button" data-command="canvas">Abrir no canvas</button>{{/unless}}{{/if}}</div>
    {{#unless hasScene}}<div class="qe-empty"><h3>Nenhuma cena disponível</h3><p>Crie uma cena no Foundry e configure uma grade hexagonal para começar.</p></div>{{else}}
    {{#if error}}<div class="qe-message" role="alert">{{error}}</div>{{/if}}
    {{#unless enabled}}{{#unless error}}<div class="qe-message"><span>Ative este mapa para começar a revelar as áreas.</span>{{#if isGM}}<button type="button" data-command="activate">Ativar exploração</button>{{/if}}</div>{{/unless}}{{/unless}}
    {{#if exploration}}
      <div class="qe-workspace">
        <section class="qe-map-panel"><div class="qe-section-head"><div><h3>Território em descoberta</h3><small>{{#if isGM}}Ctrl/Shift + clique para selecionar várias áreas. No canvas, arraste uma caixa.{{else}}Selecione um lugar para consultar suas informações.{{/if}}</small></div><div class="qe-legend"><span>◌ Oculto</span><span>◐ Parcial</span><span>● Explorado</span></div></div>
          {{#if isGM}}<div class="qe-selection-toolbar"><span>{{selectionCount}} selecionadas</span><button type="button" data-command="clear">Limpar seleção</button><label class="qe-check"><input type="checkbox" data-view="showInactive" {{#if showInactive}}checked{{/if}}> Mostrar desativadas</label></div>{{/if}}
          {{#unless error}}<svg class="qe-map" viewBox="{{viewBox}}" role="group" aria-label="Mapa de {{sceneName}}" data-gm="{{isGM}}" style="--qe-gm-opacity:{{config.gmOpacity}};--qe-cover:{{config.color}}">
            {{#if background}}<image href="{{background}}" x="{{bounds.x}}" y="{{bounds.y}}" width="{{bounds.width}}" height="{{bounds.height}}" preserveAspectRatio="none"/>{{/if}}
            {{#each cells}}<g class="qe-cell {{state}} {{#unless active}}inactive{{/unless}} {{#if selected}}selected{{/if}}" data-hex="{{id}}" role="button" tabindex="0" aria-label="{{name}}"><title>{{name}}{{#unless active}} · desativada{{/unless}}</title><polygon points="{{points}}"/>{{#if showLabel}}<text>{{#each labelLines}}<tspan x="{{x}}" y="{{y}}">{{text}} </tspan>{{/each}}</text>{{/if}}</g>{{/each}}
          </svg>{{/unless}}
          <div class="qe-map-help">A grade e os vínculos continuam fixos. Desativar bordas tira essas áreas da contagem; renumerar altera somente os números visíveis.</div>
        </section>
        {{> qeInspector}}
      </div>
    {{/if}}
    {{#if hexList}}<div class="qe-workspace"><section class="qe-list-panel"><form data-filter-form class="qe-filter"><label>Busca<input name="search" value="{{search}}" placeholder="Número, nome, região ou tag"></label><label>Estado<select name="state"><option value="">Todos</option>{{#each states}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><button type="submit">Filtrar</button></form><div class="qe-selection-toolbar"><label class="qe-check"><input type="checkbox" data-view="unassigned" {{#if unassigned}}checked{{/if}}> Sem região</label>{{#if isGM}}<label class="qe-check"><input type="checkbox" data-view="showInactive" {{#if showInactive}}checked{{/if}}> Desativadas</label>{{/if}}</div><small class="qe-list-count">{{filteredCount}} áreas encontradas{{#if limited}} · mostrando as primeiras 200{{/if}}</small><div class="qe-hex-list">{{#each filtered}}<button type="button" class="qe-hex-row {{#if selected}}selected{{/if}}" data-hex="{{id}}"><span><strong>{{#if name}}{{name}}{{else}}{{label}}{{/if}}</strong><small>{{shortCode}}{{#if region}} · {{region}}{{else}} · sem região{{/if}}</small></span><span class="qe-badge {{state}}">{{stateLabel}}</span></button>{{else}}<p class="qe-empty">Nenhuma área corresponde ao filtro.</p>{{/each}}</div></section>{{> qeInspector}}</div>{{/if}}
    {{#if settings}}<section class="qe-card qe-settings"><h3>Configuração do mapa</h3><p>Estas opções também estão na aba Explorador da configuração da cena. Os códigos técnicos ficam internos; o mapa mostra nomes simples.</p><form data-config-form>
      <label class="qe-check"><input type="checkbox" name="enabled" {{#if config.enabled}}checked{{/if}}> Ativar exploração nesta cena</label>
      <label>Nomes no mapa<select name="labelMode">{{#each labelModes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>Estado inicial<select name="defaultState">{{#each defaultStates}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>Cor da cobertura<input type="color" name="color" value="{{config.color}}"></label>
      <label>Opacidade para a Mestra<input type="number" name="gmOpacity" min="0" max="1" step="0.01" value="{{config.gmOpacity}}"></label>
      <button class="qe-primary" type="submit">Salvar configuração</button>
    </form><div class="qe-renumber"><h3>Organizar a numeração</h3><p class="qe-hint">Depois de desativar as bordas, renumere as áreas ativas de 001 em diante. Nomes, terreno, região, NPCs e notas continuam na mesma área.</p><button type="button" data-command="renumber" {{#unless enabled}}disabled{{/unless}}>Renumerar áreas ativas</button></div></section>{{/if}}
    {{#if tagManager}}<section class="qe-card"><h3>Tags da campanha</h3><p>As tags do Quedaço aparecem automaticamente quando o módulo está ativo. Você também pode criar suas próprias tags e aplicá-las a uma ou várias áreas.</p><form data-tag-form class="qe-tag-form"><label>Nova tag<input name="tagName" maxlength="60" required placeholder="Ruínas, porto, rota segura…"></label><button type="submit">Criar tag</button></form><div class="qe-tag-list">{{#each tags}}<span class="qe-badge">{{label}}</span>{{else}}<p class="qe-hint">Crie a primeira tag da campanha.</p>{{/each}}</div><p class="qe-hint">A presença de NPCs vem das atribuições do Quedaço. Uma tag, sozinha, não afirma que alguém está no lugar.</p></section>{{/if}}
    {{#if integration}}<section class="qe-card qe-integrations"><h3>Quedaço no controle da campanha</h3><p>O módulo principal pode definir regiões, atribuir NPCs, mudar a localização do grupo e abrir o Explorador. Calendário e diário usam a mesma localização estável nas anotações.</p><pre><code>{{integrationCode}}</code></pre><div class="qe-integration-actions"><button type="button" data-command="export">Exportar dados</button>{{#if legacy}}<button type="button" data-command="import" {{#unless enabled}}disabled{{/unless}}>Importar estados do World Explorer</button>{{/if}}</div><p class="qe-hint">Os contratos e as instruções para atualizar o Quedaço estão em docs/INTEGRACAO-QUEDACO.md. Descrições são compartilhadas na cena; segredos ficam em diários privados.</p></section>{{/if}}
    {{/unless}}
  </main>
</div>

{{#*inline "qeInspector"}}
<aside class="qe-inspector">
  {{#if selected}}<div class="qe-inspector-head" data-selected-area="{{selected.id}}"><small>{{#if multiple}}EDIÇÃO EM GRUPO{{else}}LOCALIDADE{{/if}}</small><h3>{{#if multiple}}{{selectionCount}} áreas selecionadas{{else}}{{selectedName}}{{/if}}</h3>{{#unless multiple}}<span class="qe-badge">{{selected.shortCode}}</span><span class="qe-badge {{selected.state}}">{{#if selected.active}}{{selectedState}}{{else}}Desativada{{/if}}</span>{{/unless}}</div>
    {{#if isGM}}<div class="qe-area-actions"><button type="button" data-command="disable" {{#unless enabled}}disabled{{/unless}}>Desativar {{#if multiple}}seleção{{else}}área{{/if}}</button><button type="button" data-command="enable" {{#unless enabled}}disabled{{/unless}}>Reativar</button></div>{{/if}}
    {{#if multiple}}
      <p class="qe-hint">Só os campos escolhidos serão alterados. Os nomes e demais informações de cada área são preservados.</p>
      <form data-batch-form>
        <label>Terreno<select name="terrain"><option value="__keep">Manter como está</option>{{#each terrains}}<option>{{label}}</option>{{/each}}</select></label>
        <label>Região<select name="regionId"><option value="__keep">Manter como está</option><option value="">Sem região</option>{{#each regions}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
        <details class="qe-tag-picker"><summary>Adicionar tags à seleção</summary>{{#each tags}}<label class="qe-check"><input type="checkbox" name="tags" value="{{id}}">{{label}}</label>{{/each}}</details>
        <button class="qe-primary" type="submit" {{#unless enabled}}disabled{{/unless}}>Aplicar às {{selectionCount}} áreas</button>
      </form>
    {{else}}
      <button type="button" data-command="focus">Centralizar no canvas</button>
      {{#if isGM}}<div class="qe-state-actions"><button type="button" data-state="hidden" {{#unless selected.active}}disabled{{/unless}}>Ocultar</button><button type="button" data-state="partial" {{#unless selected.active}}disabled{{/unless}}>Parcial</button><button type="button" data-state="explored" {{#unless selected.active}}disabled{{/unless}}>Explorar</button></div>
        <form data-hex-form>
          <label>Nome fantasia<input name="name" value="{{selected.name}}" maxlength="200" placeholder="{{selected.label}} · escolha um nome"></label>
          <label>Terreno<select name="terrain">{{#if customTerrain}}<option selected>{{customTerrain}}</option>{{/if}}{{#each terrains}}<option {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label>Região<select name="regionId"><option value="" {{#if noRegion}}selected{{/if}}>Sem região</option>{{#each regions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
          {{#if places}}<label>Localidade do Quedaço<select name="placeId"><option value="">Sem localidade específica</option>{{#each places}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
          <details class="qe-tag-picker"><summary>Tags da área</summary>{{#each tags}}<label class="qe-check"><input type="checkbox" name="tags" value="{{id}}" {{#if selected}}checked{{/if}}>{{label}}</label>{{else}}<p class="qe-hint">Crie tags pelo menu lateral.</p>{{/each}}</details>
          <label>Descrição compartilhada<textarea name="description" rows="3" maxlength="12000">{{selected.description}}</textarea></label>
          <details><summary>Vincular cenas e diários</summary><label>UUID da cena<input name="sceneUuid" value="{{selected.sceneUuid}}" placeholder="Scene.ID"></label><label>UUID do diário<input name="journalUuid" value="{{selected.journalUuid}}" placeholder="JournalEntry.ID"></label></details>
          <button class="qe-primary" type="submit" {{#unless enabled}}disabled{{/unless}}>Salvar área</button>
        </form>
      {{else}}<p>{{selected.terrain}}{{#if selected.region}} · {{selected.region}}{{/if}}</p><p class="qe-description">{{selected.description}}</p>{{/if}}
      <section class="qe-npcs"><h3>Quem está aqui</h3>{{#each npcs.present}}<div class="qe-npc-row"><span>{{name}}</span>{{#if ../isGM}}<button type="button" data-remove-npc="{{uuid}}" title="Retirar desta área">Retirar</button>{{/if}}</div>{{else}}<p class="qe-hint">Nenhum NPC atribuído a esta área.</p>{{/each}}
        {{#if isGM}}<form data-npc-form><label>Atribuir NPC do Quedaço<select name="npc" required><option value="">Escolha um NPC</option>{{#each npcCandidates}}<option value="{{uuid}}">{{name}}</option>{{/each}}</select></label><button type="submit" {{#unless selected.active}}disabled{{/unless}}>Atribuir à área</button></form>{{#if npcs.regional}}<details><summary>NPCs da região sem área definida</summary>{{#each npcs.regional}}<p class="qe-hint">{{name}}</p>{{/each}}</details>{{/if}}{{/if}}
      </section>
      <section class="qe-notes"><h3>Diário deste lugar</h3>{{#if isGM}}<button type="button" data-command="current" {{#unless selected.active}}disabled{{/unless}}>{{#if selectedIsCurrent}}Grupo está aqui{{else}}Definir como local do grupo{{/if}}</button>{{/if}}
        {{#each notes}}<button type="button" class="qe-note-card" data-note="{{uuid}}"><strong>{{title}}</strong><small>{{dateLabel}} · {{author}}</small></button>{{else}}<p class="qe-hint">Ainda não há notas visíveis vinculadas a este lugar.</p>{{/each}}
        {{#if canCreateNote}}<details><summary>Anotação HEX {{selected.shortCode}} · Anotação do grupo</summary><form data-note-form><label>Título<input name="title" maxlength="160" placeholder="Anotação HEX {{selected.shortCode}} · Anotação do grupo"></label><label>Anotação<textarea name="description" required rows="3" maxlength="20000"></textarea></label><label>Visibilidade<select name="visibility"><option value="private" selected>Pessoal — só eu</option><option value="public">Pública — todos da mesa</option></select></label>{{#unless calendarConnected}}<fieldset><legend>Data Skyfall</legend><label>Anel<input type="number" name="year" value="0" step="1" required></label><label>Ciclo<input type="number" name="cycle" value="1" min="1" max="16" required></label><label>Dia<input type="number" name="day" value="1" min="1" max="15" required></label></fieldset><p class="qe-hint">O Calendário não está ativo; a data será registrada no padrão Skyfall.</p>{{else}}<p class="qe-hint">A data atual do Calendário será adicionada automaticamente. Clima poderá ser acrescentado depois.</p>{{/unless}}<button type="submit">Salvar anotação pessoal</button></form></details>{{/if}}
      </section>
      <div class="qe-links">{{#if selected.sceneUuid}}<button type="button" data-command="scene">Abrir cena vinculada</button>{{/if}}{{#if selected.journalUuid}}<button type="button" data-command="journal">Abrir diário vinculado</button>{{/if}}</div>
    {{/if}}
  {{else}}<div class="qe-empty"><h3>Selecione uma área</h3><p>{{#if isGM}}Clique para editar. Ctrl/Shift + clique seleciona várias áreas para atribuir terreno, região e tags de uma vez.{{else}}Selecione um lugar no mapa para ver suas informações e anotações.{{/if}}</p></div>{{/if}}
</aside>
{{/inline}}
